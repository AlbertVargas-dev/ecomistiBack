# Copiar a .env y completar. NUNCA commitear .env (esta en .gitignore).
DATABASE_URL=postgresql://ecomisti:ecomisti@localhost:5432/ecomisti
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Access token: por defecto 15m (spec §4); no hace falta definirlo.
# JWT_EXPIRES_IN=15m
PORT=3000
# Rate limiting (spec §4): por defecto 100 req/min general y 10 req/min en login/registro.
# THROTTLE_DEFAULT_LIMIT=100
# THROTTLE_LOGIN_LIMIT=10
# NestJS Observe (ver AGENTS.md)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
