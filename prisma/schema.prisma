// EcoMisti - schema Prisma (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECOLECTOR
  CIUDADANO
  URBANIZACION
  RENTAS
}

enum TipoResiduo {
  RECICLABLE
  ORGANICO
}

enum EstadoVoucher {
  EMITIDO
  APLICADO
  VENCIDO
  CANCELADO
}

enum TipoMovimiento {
  ACREDITO
  CANJE
  REVERSA_ENTREGA
  REVERSA_CANJE
  AJUSTE
}

enum EstadoEntrega {
  VALIDA
  ANULADA
}

enum EstadoObra {
  PENDIENTE
  EN_EJECUCION
  COMPLETADA
}

enum EstadoRuta {
  ACTIVA
  SUSPENDIDA
}

enum EstadoIncidencia {
  ABIERTA
  EN_REVISION
  RESUELTA
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  nombres      String
  apellidos    String
  dni          String  @unique
  telefono     String?
  rol          Role    @default(CIUDADANO)

  qrCode           String    @unique @default(uuid()) // regenerable; el anterior queda invalido
  activo           Boolean   @default(true) // false = desactivado (no se borra: valor tributario)
  intentosFallidos Int       @default(0) // bloqueo tras 5 fallos (§4)
  bloqueadoHasta   DateTime?
  desactivadoAt    DateTime? // revocacion de recolector: sync acepta fechaCaptura anterior (§7)
  aceptoTerminosAt DateTime? // consentimiento Ley 29733 (§11)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perfilRecolector PerfilRecolector?

  entregasRegistradas Entrega[] @relation("RecolectorEntregas")
  entregas            Entrega[] @relation("UsuarioEntregas")

  movimientos MovimientoPuntos[]

  vouchers VoucherCanje[]

  auditorias        AuditLog[] @relation("AuditoriaActor")
  auditoriasSobreMi AuditLog[] @relation("AuditoriaUsuario")

  factoresComunidades ConfigFactorResiduo[] @relation("FactorCreadoPor")
  rutasAsignadas      Ruta[]
  vehiculos           Vehiculo[]
  incidencias         Incidencia[]
  notificaciones      Notificacion[]

  urbanizacionId String?
  urbanizacion   Urbanizacion? @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)

  cooperativaId String?
  cooperativa   Cooperativa? @relation(fields: [cooperativaId], references: [id], onDelete: Restrict)

  puntosBalance EcoPuntosBalance?

  @@map("users")
}

model PerfilRecolector {
  id        String @id @default(uuid())
  usuarioId String @unique
  usuario   User   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  dni        String  @unique // 8 digitos (§11)
  nombres    String
  telefono   String?
  zonaCamion String?
  pinHash    String // hash bcrypt del PIN de 6 digitos; cambio obligatorio al primer ingreso (§4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("perfil_recolector")
}

model PuntoEncuentro {
  id        String   @id @default(uuid())
  nombre    String
  distrito  String
  direccion String
  latitud   Float
  longitud  Float
  horario   String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  entregas Entrega[]

  @@map("puntos_encuentro")
}

model Entrega {
  id             String  @id @default(uuid())
  idempotencyKey String  @unique
  deviceId       String?

  usuarioId    String // dueno de la cuenta cuyo QR se escaneo (CIUDADANO o URBANIZACION)
  usuario      User   @relation("UsuarioEntregas", fields: [usuarioId], references: [id], onDelete: Restrict)
  recolectorId String
  recolector   User   @relation("RecolectorEntregas", fields: [recolectorId], references: [id], onDelete: Restrict)

  puntoEncuentroId String?
  puntoEncuentro   PuntoEncuentro? @relation(fields: [puntoEncuentroId], references: [id], onDelete: Restrict)

  qrCode        String? // QR capturado al momento del pesaje (para detectar QR_INVALIDO)
  fechaCaptura  DateTime // fecha del pesaje en el movil; rige factor y validaciones
  puntosTotales Int      @default(0) // suma de puntosSubtotal (backend siempre recalcula)
  volumenM3     Float? // volumen estimado o del movil (diseno: columna Volumen)

  rutaId String?
  ruta   Ruta?   @relation(fields: [rutaId], references: [id], onDelete: Restrict)

  estado          EstadoEntrega @default(VALIDA)
  motivoAnulacion String?
  anuladoPor      String? // userId del ADMIN (sin FK dura para no bloquear auditoria)

  createdAt DateTime @default(now())

  detalles    DetalleEntrega[]
  movimientos MovimientoPuntos[]

  @@index([usuarioId, fechaCaptura])
  @@index([recolectorId, fechaCaptura])
  @@index([puntoEncuentroId])
  @@index([rutaId])
  @@map("entregas")
}

model Ruta {
  id           String     @id @default(uuid())
  nombre       String // ej. "Ruta Sur 1"
  zona         String?
  recolectorId String?
  recolector   User?      @relation(fields: [recolectorId], references: [id], onDelete: Restrict)
  estado       EstadoRuta @default(ACTIVA)
  createdAt    DateTime   @default(now())

  entregas Entrega[]

  @@map("rutas")
}

model Vehiculo {
  id           String   @id @default(uuid())
  placa        String   @unique
  tipo         String // ej. "Camion", "Mototaxi", "Bicicleta"
  capacidadKg  Float
  recolectorId String?
  recolector   User?    @relation(fields: [recolectorId], references: [id], onDelete: Restrict)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("vehiculos")
}

model Incidencia {
  id          String           @id @default(uuid())
  usuarioId   String
  usuario     User             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo        String // ej. "Punto saturado", "Basura en via publica"
  descripcion String
  fotoUrl     String?
  latitud     Float?
  longitud    Float?
  estado      EstadoIncidencia @default(ABIERTA)
  createdAt   DateTime         @default(now())

  @@index([usuarioId, createdAt])
  @@index([estado])
  @@map("incidencias")
}

// Notificacion al ciudadano cuando alcanza el hito de una recompensa
// (puntosActuales >= costoPuntos por primera vez). Una por usuario+oferta.
model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo      String // ej. HITO_RECOMPENSA
  titulo    String
  mensaje   String
  ofertaId  String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([usuarioId, ofertaId, tipo])
  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// Urbanizacion a la que pertenece el representante legal (rol URBANIZACION).
model Urbanizacion {
  id        String   @id @default(uuid())
  nombre    String   @unique
  direccion String?
  distrito  String?
  createdAt DateTime @default(now())

  usuarios User[]

  @@map("urbanizaciones")
}

// Copaff: cooperativas/asociaciones de recicladores (menu del diseno).
model Cooperativa {
  id        String   @id @default(uuid())
  nombre    String
  ruc       String?  @unique
  direccion String?
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  miembros User[]

  @@map("cooperativas")
}

// Detalles de pesaje: factor congelado en fechaCaptura, max. 20 por entrega.
model DetalleEntrega {
  id        String  @id @default(uuid())
  entregaId String
  entrega   Entrega @relation(fields: [entregaId], references: [id], onDelete: Restrict)

  tipoResiduo    TipoResiduo
  pesoKg         Decimal     @db.Decimal(8, 2)
  factor         Decimal     @db.Decimal(8, 2) // factor vigente en fechaCaptura
  puntosSubtotal Int // round(pesoKg * factor)

  @@index([entregaId])
  @@map("detalles_entrega")
}

// Factor versionado: el aplicable es el vigente en fechaCaptura; nunca se edita.
model ConfigFactorResiduo {
  id           String      @id @default(uuid())
  tipoResiduo  TipoResiduo
  factor       Decimal     @db.Decimal(8, 2) // puntos por kg (RECICLABLE 10, ORGANICO 5)
  vigenteDesde DateTime
  creadoPorId  String
  creadoPor    User        @relation("FactorCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tipoResiduo, vigenteDesde])
  @@map("config_factor_residuo")
}

model EcoPuntosBalance {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  puntosActuales   Int      @default(0) // puede quedar negativo tras una reversa (spec §10)
  puntosHistoricos Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("ecopuntos_balance")
}

// Ledger inmutable: cada cambio de balance va con un movimiento en la misma $transaction.
model MovimientoPuntos {
  id             String         @id @default(uuid())
  usuarioId      String
  usuario        User           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo           TipoMovimiento
  monto          Int // positivo suma, negativo resta
  saldoPosterior Int // saldo despues del movimiento

  entregaId String?
  entrega   Entrega?      @relation(fields: [entregaId], references: [id], onDelete: Restrict)
  voucherId String?
  voucher   VoucherCanje? @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  motivo    String? // obligatorio en REVERSA_* y AJUSTE
  creadoPor String? // userId que origino el movimiento

  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@map("movimientos_puntos")
}

model OfertaRecompensa {
  id                  String    @id @default(uuid())
  titulo              String
  descripcion         String
  costoPuntos         Int // antes puntosCosto
  dirigidoA           Role // CIUDADANO o URBANIZACION: nadie canjea ofertas del otro rol
  stockDisponible     Int? // null = ilimitado
  fechaInicio         DateTime?
  fechaFin            DateTime?
  limitePorUsuario    Int? // null = sin limite
  diasVigenciaVoucher Int       @default(90)
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now())

  vouchers VoucherCanje[]

  @@map("ofertas_recompensa")
}

model VoucherCanje {
  id        String           @id @default(uuid())
  usuarioId String
  usuario   User             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ofertaId  String
  oferta    OfertaRecompensa @relation(fields: [ofertaId], references: [id], onDelete: Restrict)

  codigoVoucher String        @unique // codigo que consulta RENTAS/ADMIN
  puntosUsados  Int
  estado        EstadoVoucher @default(EMITIDO)

  fechaVencimiento  DateTime
  fechaAplicacion   DateTime?
  aplicadoPor       String?
  motivoCancelacion String?
  canceladoPor      String?

  estadoObra EstadoObra? // solo urbanizaciones, tras APLICADO

  createdAt DateTime @default(now())

  movimientos MovimientoPuntos[]

  @@index([usuarioId, estado])
  @@map("vouchers_canje")
}

model AuditLog {
  id                String  @id @default(uuid())
  usuarioId         String? // actor
  actor             User?   @relation("AuditoriaActor", fields: [usuarioId], references: [id], onDelete: Restrict)
  usuarioAfectadoId String? // afectado (si difiere del actor)
  usuarioAfectado   User?   @relation("AuditoriaUsuario", fields: [usuarioAfectadoId], references: [id], onDelete: Restrict)

  accion    String
  entidad   String
  entidadId String
  detalle   Json? // contexto adicional (nunca passwordHash ni pinHash)

  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId])
  @@map("audit_log")
}
